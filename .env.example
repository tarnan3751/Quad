# Quad server configuration. Copy to `.env` (gitignored) and adjust.
# `docker compose --profile server` reads this file automatically; for `./gradlew :server:run` export the
# variables in your shell (e.g. `set -a; source .env; set +a`). Every variable is optional in development.
# Defaults shown are what the server uses when the variable is unset or blank.

# --- HTTP ---
# Port the server listens on.
PORT=8080
# Origin the apps use to reach the server; used to build absolute photo URLs and Stripe return/redirect URLs.
# On an Android emulator the host machine is http://10.0.2.2:8080; on a real device use your LAN IP or a tunnel.
PUBLIC_BASE_URL=http://localhost:8080

# --- Database (PostgreSQL 17; docker-compose.yml exposes it on 127.0.0.1:5434) ---
DATABASE_URL=jdbc:postgresql://127.0.0.1:5434/campus_market
DATABASE_USER=campus
DATABASE_PASSWORD=campus

# --- Security ---
# HMAC secret for access tokens. Must be >= 32 random chars and not the dev default when DEV_MODE=false
# (generate one with `openssl rand -base64 48`). The server refuses to start otherwise.
JWT_SECRET=dev-only-secret-change-me-dev-only-secret-change-me
# true: verification codes are also returned in API responses and logged (instead of only being emailed).
# MUST be false in production. The seed tool refuses to run when false. With false the server refuses to start
# unless STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET and SMTP_HOST are set; with true it refuses a live (sk_live_) key.
DEV_MODE=true

# Reverse proxies in front of the server that append to X-Forwarded-For (usually 1 behind a TLS-terminating proxy).
# The auth rate limits key on the client address they report; with 0 the TCP peer is taken as the client.
TRUSTED_PROXY_HOPS=0

# --- Accounts ---
# Comma-separated email suffixes allowed to register (campus addresses).
ALLOWED_EMAIL_SUFFIXES=.edu
# Comma-separated emails granted the ADMIN role when they verify their address.
ADMIN_EMAILS=

# --- Photos ---
# Directory for uploaded photos (served at /uploads/<key>). Local disk only for now.
UPLOADS_DIR=uploads

# --- Payments (Stripe Connect) ---
# Leave STRIPE_SECRET_KEY empty to use the fake in-process payment gateway (no network, local simulated checkout).
# Set it to an sk_test_... key to use real Stripe in test mode.
STRIPE_SECRET_KEY=
# Signing secret printed by `stripe listen --forward-to localhost:8080/api/v1/stripe/webhook` (whsec_...), or the
# endpoint secret from the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=
# Platform fee in basis points of the item price (500 = 5%).
PLATFORM_FEE_BPS=500
# URL scheme the apps register; Stripe/fake checkout return pages redirect to <base>orders/{id} and <base>payouts.
APP_DEEP_LINK_BASE=campusmarket://
# Hours after payment (or after the buyer withdraws a reported problem) when a paid order's money is released to the
# seller automatically, unless the buyer confirmed receipt first or reported a problem. Whole hours >= 1. The Terms
# page says 72 hours: change both together.
AUTO_RELEASE_HOURS=72

# --- Email (verification codes) ---
# When SMTP_HOST is empty, emails are only logged (LogMailer). Set it to send real mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Quad <no-reply@campusmarket.local>

# --- Legal pages (/legal/terms, /legal/privacy, /legal/guidelines) ---
# Shown in the starter legal pages; when empty a visible placeholder is rendered instead. Have counsel review the pages before launch.
LEGAL_ENTITY_NAME=
SUPPORT_EMAIL=
