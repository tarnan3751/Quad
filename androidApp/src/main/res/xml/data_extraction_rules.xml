<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (android:dataExtractionRules): cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="campusmarket_secure_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="campusmarket_secure_session.xml" />
    </device-transfer>
</data-extraction-rules>
