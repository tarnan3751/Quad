<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window behind Compose: warm white (after dark at night), so a cold start or a rotation never flashes a
         plain white or black window before the first frame. Compose draws edge to edge on top of it. -->
    <style name="Base.Theme.Quad" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/quad_background</item>
        <item name="android:colorAccent">@color/quad_accent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Quad" parent="Base.Theme.Quad" />
</resources>
